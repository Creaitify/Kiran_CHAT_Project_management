# Backend
# Debug value for api server use it as 0 for production use
DEBUG=0
# nexus-chat's standalone dev server runs on 8080 and calls this API with
# credentials. It drops off the list once chat moves into apps/web at Stage 3.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3100,http://localhost:8080"

# =============================================================================
# Database
# =============================================================================
#
# DATABASE_URL is the primary path. When it is set it wins outright — the
# POSTGRES_* variables below are ignored. Point it anywhere: the local Docker
# Postgres, Neon, RDS, Supabase. Full guide: CONNECTORS.md at the repo root.
#
# -----------------------------------------------------------------------------
# Local development (Docker compose) — the default, works out of the box
# -----------------------------------------------------------------------------
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
POSTGRES_HOST="plane-db"
POSTGRES_DB="plane"
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# Neon (or any managed Postgres) — replace the DATABASE_URL above with this
# -----------------------------------------------------------------------------
#
# Neon gives you TWO hostnames for the same database. They are not
# interchangeable and using the wrong one is the usual cause of a stack that
# boots but then fails under load, or migrations that hang:
#
#   * POOLED   ep-xxxx-pooler.<region>.aws.neon.tech   <- the running app
#     Goes through Neon's PgBouncer. Handles many short-lived connections,
#     which is what Django/gunicorn/celery produce. Note the "-pooler" suffix.
#
#   * DIRECT   ep-xxxx.<region>.aws.neon.tech          <- migrations only
#     No pooler. Required for `manage.py migrate`, because DDL and advisory
#     locks need to stay on one backend for the whole transaction. Running
#     migrations through the pooler can deadlock or half-apply.
#
# sslmode=require is mandatory — Neon refuses unencrypted connections, and the
# error it returns does not say so clearly.
#
# Paste the pooled string here (keep the quotes off; this file is read raw):
# DATABASE_URL=postgresql://<user>:<password>@ep-xxxx-pooler.<region>.aws.neon.tech/<db>?sslmode=require
#
# And the direct string here. Nothing reads it automatically — it is the value
# you export in front of a migrate command. See CONNECTORS.md.
# DATABASE_URL_DIRECT=postgresql://<user>:<password>@ep-xxxx.<region>.aws.neon.tech/<db>?sslmode=require

# -----------------------------------------------------------------------------
# Connection behaviour — only applies when DATABASE_URL is set
# -----------------------------------------------------------------------------
#
# CONN_MAX_AGE: seconds Django keeps a connection open between requests.
#   MUST be 0 when DATABASE_URL points at a POOLED host. Persistent connections
#   pin a pooler slot per worker and exhaust the pool. Raise it (e.g. 60) only
#   against a direct host.
CONN_MAX_AGE=0
#
# DB_DISABLE_SERVER_SIDE_CURSORS: set to 1 when using a POOLED host.
#   A transaction-mode pooler can hand the next statement a different backend,
#   at which point a server-side cursor opened by Django's .iterator() no longer
#   exists. Symptom is an intermittent "cursor ... does not exist" on list
#   endpoints, under load only.
DB_DISABLE_SERVER_SIDE_CURSORS=0
#
# DB_CONN_HEALTH_CHECKS: revalidate a reused connection before each request.
#   Only meaningful when CONN_MAX_AGE > 0; leave at 0 with the pooler.
DB_CONN_HEALTH_CHECKS=0

# Redis Settings
REDIS_HOST="plane-redis"
REDIS_PORT="6379"
REDIS_URL="redis://${REDIS_HOST}:6379/"

# RabbitMQ Settings
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

# AWS Settings
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://localhost:9000"
# Changing this requires change in the proxy config for uploads if using minio setup
AWS_S3_BUCKET_NAME="uploads"
# Maximum file upload limit
FILE_SIZE_LIMIT=5242880
# Signed URL expiration time in seconds (default: 3600 = 1 hour)
# Set to 30 for 30 seconds, 300 for 5 minutes, etc.
SIGNED_URL_EXPIRATION=3600

# Settings related to Docker
DOCKERIZED=1 # deprecated

# set to 1 If using the pre-configured minio setup
USE_MINIO=0



# Email redirections and minio domain settings
WEB_URL="http://localhost:8000"

# Gunicorn Workers
GUNICORN_WORKERS=2

# Base URLs
ADMIN_BASE_URL="http://localhost:3001"
ADMIN_BASE_PATH="/god-mode"

SPACE_BASE_URL="http://localhost:3002"
SPACE_BASE_PATH="/spaces"

APP_BASE_URL="http://localhost:3000"
APP_BASE_PATH=""

LIVE_BASE_URL="http://localhost:3100"
LIVE_BASE_PATH="/live"

LIVE_SERVER_SECRET_KEY="secret-key"

# Hard delete files after days
HARD_DELETE_AFTER_DAYS=60

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# API key rate limit
API_KEY_RATE_LIMIT="60/minute"


