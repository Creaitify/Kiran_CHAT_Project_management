# =============================================================================
# Chat data connector
# =============================================================================
#
# Where chat's rooms, messages and read state live. Full guide: CONNECTORS.md
# at the workspace root.
#
#   local  (default)  localStorage. Seed fixtures, no backend, no key needed.
#   api               The KCMS Django backend at apps/api.
#
# Chat never opens its own Postgres connection. `api` means it talks to
# apps/api, which already owns DATABASE_URL, authentication, workspaces and
# roles — so pointing that one connection string at Neon moves chat's data too.
#
# NOTE (Stage 1): apps/api does not serve the /chat/ endpoints yet — those land
# in Stage 3. Setting this to `api` today is safe but not useful: the connector
# finds no endpoints, logs one line saying so, and falls back to seed data with
# saving disabled. The setting exists now so the wiring is proven and the switch
# is a config change later, not a code change.
VITE_CHAT_CONNECTOR=local

# Origin of apps/api. Leave empty for same origin (i.e. behind the proxy).
# Only read when VITE_CHAT_CONNECTOR=api.
# Must appear in CORS_ALLOWED_ORIGINS in apps/api/.env, or every request is
# blocked by the browser before it reaches Django.
VITE_API_BASE_URL=http://localhost:8000

# Which KCMS workspace chat is scoped to — the slug from the workspace URL.
# Only read when VITE_CHAT_CONNECTOR=api. With this empty the connector refuses
# to make any request at all rather than guess at a workspace.
# Stage 3 replaces this with the workspace from the shell's module context.
VITE_CHAT_WORKSPACE_SLUG=

# =============================================================================
# AI assistant (unrelated to the connector; server-side only)
# =============================================================================
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
